# Python tu doc file .env; bien trong terminal duoc uu tien.
PROVIDER=groq
MODEL=openai/gpt-oss-20b
GROQ_API_KEY=YOUR_GROQ_KEY

# Cac provider khac van duoc ho tro:
# OPENAI_API_KEY=YOUR_KEY
# GEMINI_API_KEY=YOUR_KEY
# ANTHROPIC_API_KEY=YOUR_KEY
# OPENROUTER_API_KEY=YOUR_KEY

# Minimum seconds between Groq requests; shared by agent and judge.
# GROQ_MIN_INTERVAL=3

# Optional: seconds to allow 429 retries per request (default 180).
# For long evaluations near the daily token quota: 7200.
# GROQ_RETRY_BUDGET=7200
